{
  "author": "Dmytro Prokopenko",
  "manifest_version": 3,
  "name": "🔥 Bookmark [Q] extension for bookmarks promoting/unpromoting",
  "version": "1.1",
  "description": "Prepends or removes 🔥 emoji from Q bookmarks with hotkeys.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "bookmarks",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "commands": {
    "prepend-emoji": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "Prepend 🔥 emoji to bookmark"
    },
    "remove-emoji": {
      "suggested_key": {
        "default": "Alt+Shift+Q",
        "mac": "Alt+Shift+Q"
      },
      "description": "Remove 🔥 emoji from bookmark"
    }
  }
}
